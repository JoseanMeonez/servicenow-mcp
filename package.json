{
  "name": "servicenow-mcp",
  "version": "0.1.0",
  "description": "Standalone MCP server for ServiceNow Table/Aggregate APIs with an update-set write gate",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "servicenow-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run test/unit test/integration",
    "test:watch": "vitest",
    "test:live": "vitest run test/live",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}
