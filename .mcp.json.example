{
  "mcpServers": {
    "servicenow-dev": {
      "type": "stdio",
      "command": "node",
      "args": [
        "--env-file=C:/Users/you/servicenow-mcp/instances/dev.env",
        "C:/Users/you/servicenow-mcp/dist/index.js"
      ]
    },
    "servicenow-prod": {
      "type": "stdio",
      "command": "node",
      "args": [
        "--env-file=C:/Users/you/servicenow-mcp/instances/prod.env",
        "C:/Users/you/servicenow-mcp/dist/index.js"
      ]
    }
  }
}
