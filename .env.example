# ServiceNow instance base URL (no trailing slash needed; it is stripped)
SN_BASE_URL=https://dev12345.service-now.com

# "basic" (username/password) or "session" (reuse a browser session created by SSO)
SN_AUTH_MODE=basic

# Your ServiceNow user name. Required in BOTH modes — the write gate uses it to
# resolve whose current update set to check.
SN_USERNAME=api.integration

# Basic Auth password (SN_AUTH_MODE=basic only). The user must have the
# snc_basic_auth_api_access role and internal_integration_user=true — see README
# "Instance user setup". Quote the password if it contains #, ; or spaces.
SN_PASSWORD="changeme"

# SN_AUTH_MODE=session only: JSON file with the captured session, re-read on every
# request so an expired session can be replaced without restarting the server.
# Format: {"cookie": "JSESSIONID=...; glide_user_route=...", "userToken": "<g_ck>"}
# Both values are required on every call, reads included. See README "SSO session mode".
# SN_SESSION_FILE=.session.json

# Write tools (create/update/delete/set update set) are only registered when true
SN_MCP_ALLOW_WRITES=false

# When true, every write is refused while the current update set is "Default"
SN_MCP_REQUIRE_UPDATE_SET=true

# Query defaults
SN_MCP_DEFAULT_LIMIT=50
SN_MCP_MAX_LIMIT=500

# HTTP behavior
SN_MCP_REQUEST_TIMEOUT_MS=30000
SN_MCP_RETRY_MAX_ATTEMPTS=3
