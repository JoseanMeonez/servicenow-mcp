# ServiceNow instance base URL (no trailing slash needed; it is stripped)
SN_BASE_URL=https://dev12345.service-now.com

# Basic Auth credentials
SN_USERNAME=admin
SN_PASSWORD=changeme

# Write tools (create/update/delete/set update set) are only registered when true
SN_MCP_ALLOW_WRITES=false

# When true, every write is refused while the current update set is "Default"
SN_MCP_REQUIRE_UPDATE_SET=true

# Query defaults
SN_MCP_DEFAULT_LIMIT=50
SN_MCP_MAX_LIMIT=500

# HTTP behavior
SN_MCP_REQUEST_TIMEOUT_MS=30000
SN_MCP_RETRY_MAX_ATTEMPTS=3
